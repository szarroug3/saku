# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/.next-prod/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python legacy
__pycache__/

# Upstream ingest downloads. These can be large and some sources, including
# CEJC, permit educational analysis but prohibit redistribution. Generated,
# source-attributed reductions belong in src/data/generated; raw archives do not.
/scripts/ingest/raw/

# Raw Datamuse API responses cached by scripts/build-en-synonyms.mjs, so a
# rerun re-fetches nothing. Not source-attributed content; only the filtered
# output (src/data/generated/en-synonyms.json) is checked in.
/scripts/.cache/

# Local learner data, not shipped
lists.json
history.json

# playwright
# The e2e suite's isolated, throwaway data directory (created per run from the
# committed fixtures in e2e/fixtures, so the app never writes to the repo root).
/e2e/.tmp/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/history.json
/settings.json
/session.json

# Local work tracker — not shipped
tasks/
.worktrees/

# Agent-managed worktrees/state (harness-created, not this project's own
# .worktrees convention above) — machine-local, never shipped
.claude/

# Bulk-job progress logs (seed-voice-audio.mjs etc.) — machine-local, not shipped
.logs/

# ffmpeg binary, copied here fresh by scripts/copy-ffmpeg-binary.mjs on every
# build (prebuild) — platform-specific, never shipped in source
/bin/
