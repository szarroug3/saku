# Saku environment variables.
#
# Copy this to `.env.local` (gitignored) and fill in the values from your
# Supabase project (Dashboard → Settings → API) plus a running VOICEVOX engine
# for the voice feature. Vercel needs the same vars under Project → Settings →
# Environment Variables.

# Supabase — the app's data + auth. Public (NEXT_PUBLIC), protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (Dashboard → Settings → API Keys → "Publishable and secret
# API keys" tab, prefixed sb_publishable_...). See src/lib/supabase/keys.ts.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (bypasses RLS), prefixed sb_secret_..., same
# dashboard tab as above. Required by /api/tts and /api/pitch-tts to WRITE
# clips to Storage, and by the seed scripts. NEVER expose to the browser. See
# src/lib/supabase/secret-key.ts.
SUPABASE_SECRET_KEY=

# Optional, server-only. Not needed for normal use — every read/write runs as
# the signed-in user under RLS. Only set this if a future admin/maintenance
# script needs to bypass RLS. NEVER expose it to the browser.
SUPABASE_DB_CONNECTION_STRING=

# Voice audio. The generated wav clips live in a PUBLIC Supabase Storage
# bucket; the browser reads them by public URL and the routes upload to it.
# Set the bucket name (must match the bucket you create in the Supabase
# Dashboard → Storage). Blank disables the roster (the app falls back to the
# browser's built-in Japanese voice).
NEXT_PUBLIC_VOICE_AUDIO_BUCKET=tts-voice

# VOICEVOX (self-hosted, https://github.com/VOICEVOX/voicevox_engine) is the
# ONE TTS engine in the app (SAK-100) — every voice, every kind of speech,
# with per-word pitch-accent correction (see src/lib/tts-synth.ts and
# src/lib/sentence-pitch.ts). Base URL of a running engine (no trailing
# slash) — for local dev:
#   docker run -d --rm -p 50021:50021 voicevox/voicevox_engine:cpu-latest
# then VOICEVOX_ENGINE_URL=http://localhost:50021. Server-only; NEVER
# NEXT_PUBLIC. Blank disables all voice audio: the ordinary Hear button and
# the pitch "Hear it" button both fall back to the browser's own voice (the
# pitch pattern's visual overline still shows either way).
VOICEVOX_ENGINE_URL=

# Firebase AI Logic, for the writing drill's grader (/practice/write). Only
# the AI goes through Firebase: data and sign-in stay on Supabase. Values from
# the Firebase console, Project settings, Your apps, Web app. These are public
# by design; App Check is what keeps others from using the project. Blank
# leaves the drill up with grading off. Setup steps: docs/hybrid-ai.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# App Check. Production: a score-based reCAPTCHA Enterprise web key (no
# checkbox, no localhost). Local dev: leave the key blank and set a debug
# token you registered under App Check, Apps, Manage debug tokens.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# The cloud model, when the device has none. Blank uses gemini-3.5-flash-lite,
# which needs no billing.
NEXT_PUBLIC_GEMINI_CLOUD_MODEL=
