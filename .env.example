# Saku environment variables.
#
# Copy this to `.env.local` (gitignored) and fill in the values from your
# Supabase project (Dashboard → Settings → API) plus a running VOICEVOX engine
# for the voice feature. Vercel needs the same vars under Project → Settings →
# Environment Variables.

# Supabase — the app's data + auth. Public (NEXT_PUBLIC), protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (Dashboard → Settings → API Keys → "Publishable and secret
# API keys", prefixed sb_publishable_...) — Supabase's replacement for the
# legacy anon key below. Prefer this once you have it; the legacy var stays
# supported as a fallback (src/lib/supabase/keys.ts) until you disable it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key (bypasses RLS). Required by /api/tts and
# /api/pitch-tts to WRITE clips to Storage. NEVER expose to the browser.
# SUPABASE_SECRET_KEY (prefixed sb_secret_...) is the replacement for the
# legacy service_role key below — same fallback relationship as above, see
# src/lib/supabase/secret-key.ts.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voice audio. The generated wav clips live in a PUBLIC Supabase Storage
# bucket; the browser reads them by public URL and the routes upload to it.
# Set the bucket name (must match the bucket you create in the Supabase
# Dashboard → Storage). Blank disables the roster (the app falls back to the
# browser's built-in Japanese voice).
NEXT_PUBLIC_VOICE_AUDIO_BUCKET=tts-voice

# VOICEVOX (self-hosted, https://github.com/VOICEVOX/voicevox_engine) is the
# ONE TTS engine in the app (SAK-100) — every voice, every kind of speech,
# with per-word pitch-accent correction (see src/lib/tts-synth.ts and
# src/lib/sentence-pitch.ts). Base URL of a running engine (no trailing
# slash) — for local dev:
#   docker run -d --rm -p 50021:50021 voicevox/voicevox_engine:cpu-latest
# then VOICEVOX_ENGINE_URL=http://localhost:50021. Server-only; NEVER
# NEXT_PUBLIC. Blank disables all voice audio: the ordinary Hear button and
# the pitch "Hear it" button both fall back to the browser's own voice (the
# pitch pattern's visual overline still shows either way).
VOICEVOX_ENGINE_URL=
