# Saku environment variables.
#
# Copy this to `.env.local` (gitignored) and fill in the values from your
# Supabase project (Dashboard → Settings → API) plus an Azure Speech key for the
# voice feature. Vercel needs the same vars under Project → Settings →
# Environment Variables.

# Supabase — the app's data + auth. Public (NEXT_PUBLIC), protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service key (bypasses RLS). Required by the voice seeder and the
# on-demand /api/tts route to WRITE clips to Storage. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Voice audio (soothing TTS). The generated mp3 clips live in a PUBLIC Supabase
# Storage bucket; the browser reads them by public URL and the seeder/route
# upload to it. Set the bucket name (must match the bucket you create in the
# Supabase Dashboard → Storage). Blank disables the pack voices (the app falls
# back to the browser's built-in Japanese voice).
NEXT_PUBLIC_VOICE_AUDIO_BUCKET=tts-voice

# On-demand voice generation (/api/tts) + the seeder both synthesize with Azure
# Speech (free tier F0, 500k chars/month, the same Keita/Nanami voices). From the
# Azure Portal → your Speech resource → Keys and Endpoint. Region is the short
# form (e.g. eastus). Server-only; NEVER NEXT_PUBLIC. Blank disables on-demand
# (seeded kana still play; words fall back to the browser voice).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Pitch-accent audio (SAK-98) — /api/pitch-tts, a SECOND TTS engine used only
# for the Library word page's pitch "Hear it" button. Azure's voices sound
# natural but speak with their own accent, not a word's real pitch; VOICEVOX
# (self-hosted, https://github.com/VOICEVOX/voicevox_engine) exposes a
# per-mora pitch value this route hand-edits before synthesis. Base URL of a
# running engine (no trailing slash) — for local dev:
#   docker run -d --rm -p 50021:50021 voicevox/voicevox_engine:cpu-latest
# then VOICEVOX_ENGINE_URL=http://localhost:50021. Server-only; NEVER
# NEXT_PUBLIC. Blank disables the pitch "Hear it" button (the visual pattern
# still shows; the button plays nothing and the route answers 503).
VOICEVOX_ENGINE_URL=
