{
  "name": "kana-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "next dev",
    "build:curriculum-sequence": "node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-curriculum-sequence.mjs",
    "build:learn-index": "node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-learn-index.mjs",
    "build:library-index": "node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-library-index.mjs",
    "build:word-rank": "node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-word-rank.mjs",
    "build:scheduling-preview": "node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-scheduling-preview.mjs",
    "build:en-synonyms": "node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-en-synonyms.mjs",
    "prebuild": "node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-curriculum-sequence.mjs && node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-learn-index.mjs && node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-library-index.mjs && node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-word-rank.mjs && node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs scripts/build-scheduling-preview.mjs && node scripts/copy-ffmpeg-binary.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "mnemonic-images": "node scripts/build-mnemonic-images.mjs",
    "audit-corpus": "node scripts/audit-corpus.ts",
    "audit-corpus:check": "node scripts/audit-corpus.ts --check",
    "test": "env -u NODE_OPTIONS -u VSCODE_INSPECTOR_OPTIONS node ./scripts/run-unit-tests.mjs",
    "test:serial": "env -u NODE_OPTIONS -u VSCODE_INSPECTOR_OPTIONS node --conditions=react-server --import ./src/lib/conjugate/test-hooks.mjs --test --test-concurrency=1",
    "test:clean": "env -u NODE_OPTIONS -u VSCODE_INSPECTOR_OPTIONS node ./scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "E2E_HTML_REPORT=1 playwright test",
    "test:e2e:report:open": "playwright show-report"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
